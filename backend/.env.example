# =============================================================================
# Lexi AI — Backend environment template
# Copy to backend/.env and fill in your real values.
# NEVER commit the real .env file.
# =============================================================================

# --- Google Gemini -----------------------------------------------------------
# API key from Google AI Studio (https://aistudio.google.com/apikey).
# The code reads GEMINI_API_KEY (see backend/app/core/config.py).
# Powers: clause extraction, risk analysis, document comparison, chat answers.
GEMINI_API_KEY=your-gemini-api-key-here

# --- Supabase ----------------------------------------------------------------
# Project URL — Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co

# Anonymous (public) key. Protected by Row Level Security.
SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key. BYPASSES Row Level Security - backend only.
# NEVER expose this to the frontend or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT verification secret from Supabase (Settings -> API -> JWT Settings).
# OPTIONAL: the backend currently verifies tokens via the Supabase Auth API
# (backend/app/core/security.py), so this is only needed if you switch to
# local HS256 JWT verification. Uncomment if you wire that up.
# SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- Vector store (ChromaDB) -------------------------------------------------
# Where the persistent ChromaDB collection lives. Default resolves outside
# backend/ (repo-root .chroma/) so the index survives backend redeploys.
# On Render's ephemeral free-tier disk, set a persistent path or accept a
# cold-start re-index.
# CHROMA_DB_PATH=../.chroma

# --- CORS / frontend origin --------------------------------------------------
# Origin allowed by the backend's CORS middleware (backend/app/main.py).
# In development the middleware allows http://localhost:3000 and
# http://127.0.0.1:3000 by default. Set this when deploying so the backend
# can also accept your production frontend origin.
# FRONTEND_URL=https://your-frontend.onrender.com

# --- Application environment -------------------------------------------------
# development | staging | production.
# Controls log verbosity (DEBUG level in development) and FastAPI debug mode.
ENVIRONMENT=development

# Verbose debugging output. Keep false in production.
DEBUG=false

# --- Limits & tuning ---------------------------------------------------------
# Maximum pages accepted in an uploaded PDF.
MAX_PDF_PAGES=100

# Maximum characters extracted from a document before truncation.
MAX_EXTRACTED_CHARACTERS=300000

# Timeout (seconds) for OCR processing of scanned documents/images.
OCR_TIMEOUT_SECONDS=30.0

# Embedding vector dimensionality (128-3072).
# 1536 balances quality and storage cost; must stay consistent once data is
# indexed - changing it requires re-indexing.
EMBEDDING_OUTPUT_DIMENSIONALITY=1536
