# =============================================================================
# Lexi AI — Root environment template (shared reference)
#
# This file documents every variable used across the project in one place.
# In practice, copy the app-specific templates:
#   - backend/.env.example  ->  backend/.env
#   - frontend/.env.example ->  frontend/.env.local
#
# NEVER commit real .env files — they are gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (frontend/.env.local) — only NEXT_PUBLIC_* vars reach the browser
# -----------------------------------------------------------------------------

# Supabase project URL — Settings -> API in the Supabase dashboard.
# Used by the browser-side Supabase client for auth and session management.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key. Safe to expose: protected by Row Level
# Security on the server. Never place a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL of the FastAPI backend (no trailing slash).
# The code reads NEXT_PUBLIC_API_URL (frontend/lib/api-client.ts and
# frontend/app/api/health/route.ts); NEXT_PUBLIC_BACKEND_URL is an alias.
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# BACKEND (backend/.env) — server-only, never exposed to the browser
# -----------------------------------------------------------------------------

# Google AI Studio API key (https://aistudio.google.com/apikey).
# The code reads GEMINI_API_KEY (backend/app/core/config.py).
# Powers clause extraction, risk analysis, document comparison, and chat.
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase project URL (server-side clients).
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key — used for user-scoped server operations.
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service-role key. BYPASSES Row Level Security — backend only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret from Supabase (Settings -> API -> JWT Settings). OPTIONAL:
# only needed if you switch from Supabase Auth API verification to local
# HS256 JWT verification in backend/app/core/security.py.
# SUPABASE_JWT_SECRET=your-jwt-secret-here

# Persistent ChromaDB vector store path. Default resolves to the repo-root
# .chroma/ directory outside backend/. Set explicitly on ephemeral hosts.
# CHROMA_DB_PATH=../.chroma

# Frontend origin allowed by the backend CORS middleware (backend/app/main.py).
# Development defaults: http://localhost:3000 and http://127.0.0.1:3000.
# FRONTEND_URL=https://your-frontend.onrender.com

# development | staging | production — controls log verbosity & debug mode.
ENVIRONMENT=development

# Verbose debugging output. Keep false in production.
DEBUG=false

# Upload limits: max PDF pages, max extracted characters, OCR timeout (s).
MAX_PDF_PAGES=100
MAX_EXTRACTED_CHARACTERS=300000
OCR_TIMEOUT_SECONDS=30.0

# Embedding vector dimensionality (128-3072). 1536 recommended; changing it
# requires re-indexing all documents.
EMBEDDING_OUTPUT_DIMENSIONALITY=1536
